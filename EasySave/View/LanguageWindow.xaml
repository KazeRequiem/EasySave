<Window x:Class="EasySave.Views.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave - Language" Height="300" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        Background="#2D3E50">
    <Border BorderBrush="White" BorderThickness="2">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Bienvenue / Welcome" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Click="BtnFr_Click" Width="150" Height="100" Margin="10" Background="White" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="🇫🇷" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Français" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="BtnEn_Click" Width="150" Height="100" Margin="10" Background="White" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="🇺🇸" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="English" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>