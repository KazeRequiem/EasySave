<UserControl x:Class="EasySave.Views.JobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resx="clr-namespace:EasySave.Resources" 
             Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static resx:Strings.JobTitle}" FontSize="22" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="{x:Static resx:Strings.BtnCreate}" Click="BtnCreate_Click" Width="100" Height="30" Margin="0,0,10,0" Background="#28a745" Foreground="White"/>
            <Button Content="{x:Static resx:Strings.BtnModify}" Click="BtnModify_Click" Width="100" Height="30" Margin="0,0,10,0" Background="#ffc107" Foreground="Black"/>
            <Button Content="{x:Static resx:Strings.BtnDelete}" Click="BtnDelete_Click" Width="100" Height="30" Background="#dc3545" Foreground="White"/>
        </StackPanel>

        <DataGrid x:Name="DgdJobs" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  BorderThickness="1" BorderBrush="#DDD" Background="WhiteSmoke" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static resx:Strings.HeaderID}" Width="50" Binding="{Binding id}"/>
                <DataGridTextColumn Header="{x:Static resx:Strings.HeaderName}" Width="150" Binding="{Binding name}"/>
                <DataGridTextColumn Header="{x:Static resx:Strings.HeaderSource}" Width="*" Binding="{Binding sourcePath}"/>
                <DataGridTextColumn Header="{x:Static resx:Strings.HeaderDest}" Width="*" Binding="{Binding destinationPath}"/>
                <DataGridTextColumn Header="{x:Static resx:Strings.HeaderType}" Width="100" Binding="{Binding type}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>