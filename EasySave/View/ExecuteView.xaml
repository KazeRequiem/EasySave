<UserControl x:Class="EasySave.Views.ExecuteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="Exécution des Sauvegardes" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,30"/>

            <GroupBox Header="Exécution individuelle" Margin="0,0,0,20" Padding="15">
                <StackPanel>
                    <TextBlock Text="Choisir un travail à exécuter :" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbJobs" Height="35" Margin="0,0,0,10" DisplayMemberPath="name"/>
                    <Button Content="▶️ Lancer ce travail" Click="BtnRunOne_Click" Height="35" Background="#007ACC" Foreground="White"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Exécution globale" Margin="0,0,0,20" Padding="15">
                <Button Content="🚀 Lancer TOUS les travaux" Click="BtnRunAll_Click" Height="40" Background="#28a745" Foreground="White" FontSize="14" FontWeight="Bold"/>
            </GroupBox>

            <TextBlock Text="État :" FontWeight="Bold" Margin="0,10,0,5"/>
            <TextBlock x:Name="TxtStatus" Text="En attente..." FontSize="14" Foreground="Gray" TextWrapping="Wrap"/>
            <ProgressBar x:Name="PbProgress" Height="20" Margin="0,10,0,0" Minimum="0" Maximum="100"/>
        </StackPanel>
    </Grid>
</UserControl>