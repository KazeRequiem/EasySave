<Window x:Class="EasySave.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave 2.0 - Interface de Gestion" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Travaux de sauvegarde" Grid.Column="0" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="JobsDataGrid" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single"
                          SelectionChanged="JobsDataGrid_SelectionChanged"
                          ItemsSource="{Binding backupJobs}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="40"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding name}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding type}" Width="80"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding sourcePath}" Width="150"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding destinationPath}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="▶ Exécuter" Click="ExecuteJob_Click" Width="100" Height="35" Margin="5" Background="LightGreen" FontWeight="Bold"/>
                    <Button Content="⏸ Pause" Click="PauseJob_Click" Width="80" Height="35" Margin="5" Background="LightYellow"/>
                    <Button Content="⏹ Stop" Click="StopJob_Click" Width="80" Height="35" Margin="5" Background="#FFCCCC"/>
                    <Button Content="🗑 Supprimer" Click="DeleteJob_Click" Width="100" Height="35" Margin="20,5,5,5"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="Détails du travail" Grid.Column="1">
            <StackPanel Margin="10">

                <Label Content="Nom du travail :" FontWeight="SemiBold"/>
                <TextBox x:Name="txtName" Height="25" Margin="0,0,0,10"/>

                <Label Content="Chemin Source :" FontWeight="SemiBold"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                    <Button Content="..." Click="BrowseSource_Click" Width="30" DockPanel.Dock="Right" Margin="5,0,0,0"/>
                    <TextBox x:Name="txtSource" Height="25"/>
                </DockPanel>

                <Label Content="Chemin Destination :" FontWeight="SemiBold"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                    <Button Content="..." Click="BrowseDest_Click" Width="30" DockPanel.Dock="Right" Margin="5,0,0,0"/>
                    <TextBox x:Name="txtDest" Height="25"/>
                </DockPanel>

                <Label Content="Type de sauvegarde :" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbType" Height="25" Margin="0,0,0,20">
                    <ComboBoxItem Content="Full" IsSelected="True"/>
                    <ComboBoxItem Content="Differential"/>
                </ComboBox>

                <Button Content="➕ Créer nouveau" Click="CreateJob_Click" Height="40" Margin="0,5,0,5" FontWeight="Bold"/>
                <Button Content="💾 Enregistrer modifs" Click="ModifyJob_Click" Height="40" Margin="0,5,0,5"/>

                <Separator Margin="0,20"/>
                <Button Content="Vider le formulaire" Click="ClearFields_Click"/>

            </StackPanel>
        </GroupBox>
    </Grid>
</Window>