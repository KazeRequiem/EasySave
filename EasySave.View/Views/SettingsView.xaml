<UserControl x:Class="EasySave.View.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resx="clr-namespace:EasySave.View.Resources" 
             Background="White">

    <UserControl.Resources>
        <Style TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock Text="{x:Static resx:Strings.SettingsTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,25" Foreground="#2D3E50"/>

            <GroupBox Header="{x:Static resx:Strings.GroupGeneral}" Padding="15" BorderBrush="#DDD" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static resx:Strings.LabelLogType}" Margin="0,0,0,5" FontWeight="Medium"/>
                        <ComboBox x:Name="CmbLogType" HorizontalAlignment="Left" Width="200" Height="30" SelectedIndex="0">
                            <ComboBoxItem Content="JSON"/>
                            <ComboBoxItem Content="XML"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{x:Static resx:Strings.LabelBusiness}" Margin="0,0,0,5" FontWeight="Medium"/>
                        <TextBox x:Name="TxtBusinessSoft" Height="30" Padding="5" ToolTip="Ex: Calculator.exe"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.GroupCrypto}" Padding="15" BorderBrush="#DDD" Margin="0,0,0,20">
                <StackPanel>

                    <StackPanel>
                        <TextBlock Text="{x:Static resx:Strings.LabelCryptoPath}" Margin="0,0,0,5" FontWeight="Medium"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCryptoPath" Grid.Column="0" Height="30" Padding="5" Margin="0,0,10,0"/>
                            <Button Content="{x:Static resx:Strings.BtnBrowse}" Click="BtnBrowse_Click" Grid.Column="1" Width="40" Height="30"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{x:Static resx:Strings.LabelCryptoKey}" Margin="0,0,0,5" FontWeight="Medium"/>
                        <TextBox x:Name="TxtCryptoKey" Height="30" Padding="5"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{x:Static resx:Strings.LabelExtensions}" Margin="0,0,0,5" FontWeight="Medium"/>
                        <TextBox x:Name="TxtExtensions" Height="30" Padding="5" ToolTip=".txt,.json,.docx"/>
                        <TextBlock Text="{x:Static resx:Strings.SettingsInfo}" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <Button Content="{x:Static resx:Strings.BtnSave}" Click="BtnSave_Click"
                    HorizontalAlignment="Right" Width="180" Height="40" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>