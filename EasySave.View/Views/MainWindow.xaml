<Window x:Class="EasySave.View.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resx="clr-namespace:EasySave.View.Resources" 
        Title="{x:Static resx:Strings.AppTitle}" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#2D3E50">
            <TextBlock Text="{x:Static resx:Strings.AppTitle}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,20" HorizontalAlignment="Center"/>

            <Button Content="{x:Static resx:Strings.MenuJobs}" Click="BtnJobs_Click" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,5"/>
            <Button Content="{x:Static resx:Strings.MenuExecute}" Click="BtnExecute_Click" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,5"/>
            <Button Content="{x:Static resx:Strings.MenuSettings}" Click="BtnSettings_Click" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,5"/>
        </StackPanel>

        <ContentControl x:Name="ActiveContent" Grid.Column="1" Margin="20"/>
    </Grid>
</Window>