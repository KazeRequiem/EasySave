<Window x:Class="EasySave.View.Views.JobForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resx="clr-namespace:EasySave.View.Resources"
        Title="{x:Static resx:Strings.JobTitle}" 
        Width="450" 
        SizeToContent="Height" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        Background="#F5F5F7">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{x:Static resx:Strings.LblJobName}" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Height="30" Margin="0,0,0,15" Padding="5,2"/>

            <TextBlock Text="{x:Static resx:Strings.HeaderSource}" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtSource" Height="30" Margin="0,0,0,15" Padding="5,2"/>

            <TextBlock Text="{x:Static resx:Strings.HeaderDest}" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtDest" Height="30" Margin="0,0,0,15" Padding="5,2"/>

            <TextBlock Text="{x:Static resx:Strings.HeaderType}" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbType" Height="30" Margin="0,0,0,25">
                <ComboBoxItem Content="Full"/>
                <ComboBoxItem Content="Differential"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static resx:Strings.LblCancel}" 
                        IsCancel="True" 
                        Width="100" Height="32" 
                        Margin="0,0,10,0"/>

                <Button Content="{x:Static resx:Strings.BtnValidate}" 
                        Click="BtnSave_Click" 
                        Width="100" Height="32" 
                        Background="#007ACC" Foreground="White" 
                        FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>