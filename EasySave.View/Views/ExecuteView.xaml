<UserControl x:Class="EasySave.View.Views.ExecuteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resx="clr-namespace:EasySave.View.Resources"
             Background="White">

    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="{x:Static resx:Strings.ExecuteTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,30" Foreground="#2D3E50"/>

            <GroupBox Header="{x:Static resx:Strings.GroupSpecific}">
                <StackPanel>
                    <ComboBox x:Name="CmbJobs" Height="35" Margin="0,0,0,10"/>
                    <Button Content="{x:Static resx:Strings.BtnRunOne}" Click="BtnRunOne_Click" Height="35" Background="#007ACC" Foreground="White"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.GroupAll}">
                <Button Content="{x:Static resx:Strings.BtnRunAll}" Click="BtnRunAll_Click" Height="40" Background="#28a745" Foreground="White" FontWeight="Bold"/>
            </GroupBox>

            <TextBlock FontWeight="Bold" Margin="0,10,0,5">
                <Run Text="{x:Static resx:Strings.LabelProgress}" />
                <Run x:Name="StatusDisplay" Text="Prêt" />
            </TextBlock>
            <ProgressBar x:Name="PbProgress" 
             Minimum="0" 
             Maximum="100" 
             Value="0" 
             Height="20" />
            <GroupBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="▶" Width="40" Height="40" Margin="5" Background="#28a745" Foreground="White" BorderThickness="0" FontSize="10" Click="ResumeJob">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources> 
                    </Button>

                    <Button Content="⏸" Width="40" Height="40" Margin="5" Background="#E3993D" Foreground="White" BorderThickness="0" FontSize="10" Click="PauseJob">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!--<Button Content="❌¹" Width="40" Height="40" Margin="5" Background="#F74F2F" Foreground="White" BorderThickness="0" FontSize="10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>--> 

                    <Button Content="❌" Width="40" Height="40" Margin="5" Background="#CF2508" Foreground="White" BorderThickness="0" FontSize="10" Click="StopAllJobs">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>